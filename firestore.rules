// ============================================================================
// Règles de sécurité Firestore — Master Clash (édition Entreprises, BLA x Life Invader)
// À copier dans Firebase Console → Firestore Database → onglet "Règles"
//
// Modèle :
// - Comptes tablette = utilisateurs "nommés" (e-mail/mot de passe = <ID>@masterclash.local).
//   Invités = anonymes (aucun accès aux collections sensibles).
// - Super-admin = ID en jeu 122653 (email 122653@masterclash.local).
// - Les permissions sont lues depuis le doc users_v2 de l'appelant (via get()), donc les
//   règles NE font PAS confiance à l'UI : un organisateur ne peut ni s'accorder 'ques'/'gestion'
//   ni écrire un compte privilégié, même via la console.
//
// ⚠️ LIMITE CONNUE (voir plan de sécurité) : users_v2 reste lisible par tout compte nommé et
//    contient le mot de passe en clair ; et le mot de passe super-admin est encore présent dans
//    le code public. La sécurisation complète nécessite : login Firebase-Auth-only (mot de passe
//    hors du code), lecture users_v2 restreinte, dépôt privé/historique purgé. Cf. discussion.
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isNamed() { return isAuth() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function callerId() { return request.auth.token.email.replace('@masterclash.local', ''); }
    function myDocPath() { return /databases/$(database)/documents/users_v2/$(callerId()); }
    // Super-admin RACINE (ID 122653, valable avant même que son doc existe) + tout compte
    // explicitement marqué isAdmin par un admin (ex : les 2 personnes du Life en accès total).
    function isAdmin() {
      return isNamed() && (
        request.auth.token.email == '122653@masterclash.local'
        || (exists(myDocPath()) && get(myDocPath()).data.isAdmin == true)
      );
    }
    function isOwner(idIG) { return isNamed() && callerId() == idIG; }
    // Permissions de l'appelant, lues depuis SON doc users_v2 (get() ignore les règles de read)
    function myPerms() { return get(myDocPath()).data.perms; }
    function hasPerm(p) { return isNamed() && myPerms().hasAny([p]); }
    // Un compte "sûr" = ni admin, ni doté d'une permission sensible
    function acctSafe(d) { return d.isAdmin == false && !d.perms.hasAny(['ques', 'gestion']); }
    // Auto-édition de profil (nom/mdp/avatar) sans toucher aux privilèges
    function selfProfileOnly(idIG) {
      return isOwner(idIG)
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.perms == resource.data.perms;
    }

    // ===== COMPTES DE LA TABLETTE (v2) =====
    // Création/modification : super-admin (tout) ; organisateur 'gestion' (comptes NON privilégiés
    // uniquement) ; propriétaire (son profil, sans changer perms/isAdmin). Suppression : super-admin.
    match /users_v2/{idIG} {
      allow read: if isNamed();
      allow create: if isAdmin() || (hasPerm('gestion') && acctSafe(request.resource.data));
      allow update: if isAdmin()
                     || (hasPerm('gestion') && acctSafe(resource.data) && acctSafe(request.resource.data))
                     || selfProfileOnly(idIG);
      allow delete: if isAdmin();
    }

    // ===== PARTICIPANTS AU QUIZ =====
    // Lecture : comptes nommés. Écriture : super-admin ou détenteur de 'participants' (le Life).
    match /participants/{pid} {
      allow read: if isNamed();
      allow write: if isAdmin() || hasPerm('participants');
    }

    // ===== LOTS À GAGNER (récolte + répartition) =====
    // Même périmètre que les inscriptions : super-admin ou détenteur de 'participants' (le Life).
    match /lots/{lid} {
      allow read: if isAdmin() || hasPerm('participants');
      allow write: if isAdmin() || hasPerm('participants');
    }

    // ===== PARAMÈTRES (ouverture des inscriptions, etc.) =====
    match /config/{docId} {
      allow read: if isNamed();
      allow write: if isAdmin();
    }

    // ===== BANQUE DE QUESTIONS =====
    // Anti-fuite : jamais dans le site. Lecture : super-admin OU compte avec 'ques'. Écriture : super-admin.
    match /questions/{qid} {
      allow read: if isAdmin() || hasPerm('ques');
      allow write: if isAdmin();
    }

    // ===== TOUT LE RESTE (anciennes collections users/messages/contracts incluses) =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
